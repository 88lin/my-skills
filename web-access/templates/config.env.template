# web-access skill 用户偏好配置
# 此文件是模板。首次运行 check-deps.mjs 时会自动复制为 ~/.web-access/config.env
# （用户数据目录，不在 skill 目录内，升级 skill 不会覆盖或删除）。
#
# Agent 使用的浏览器 = 该浏览器的用户数据目录（含 Local State、DevToolsActivePort 所在的那一层），任何 Chromium 内核浏览器都可以：
#   macOS    ~/Library/Application Support/Google/Chrome、~/Library/Application Support/Dia/User Data
#   Windows  %LOCALAPPDATA%\Google\Chrome\User Data、%LOCALAPPDATA%\Microsoft\Edge\User Data
#   Linux    ~/.config/google-chrome、~/.config/BraveSoftware/Brave-Browser
# 旧值 chrome / chrome-canary / chromium / edge 仍可用，按平台对应到标准目录。
# - 留空：没有可复用的共享服务时，前置检查进入首次配置（列出应用数据目录、探测浏览器、询问用户后写入这里）
# - 设值：固定使用该浏览器；连不上时硬错（不擅自换浏览器、不猜端口）
WEB_ACCESS_BROWSER=

# 可选：日常浏览器的端口文件读不到时（如系统权限拒绝读取 DevToolsActivePort），显式指定已核对属于它的端口。
# 必须与上面的浏览器绑定；不会把该端口用于另一浏览器的 --browser 覆盖。
# 用 --remote-debugging-port 单独启动的调试浏览器不在支持范围内。
# 留空使用自动发现；端口失效时需更新，不自动猜测或降级。
WEB_ACCESS_CDP_PORT=
